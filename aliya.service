# VPS (systemd) - edit YOUR_USER and the paths, then:
#   sudo cp aliya.service /etc/systemd/system/
#   sudo systemctl enable --now aliya
[Unit]
Description=Aliya Official V4 Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/aliya
ExecStart=/usr/bin/env node index.js
Environment=PORT=8080
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target

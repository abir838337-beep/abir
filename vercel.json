{
  "version": 2,
  "builds": [
    {
      "src": "api/status.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/status.js"
    },
    {
      "src": "/(.*)",
      "dest": "api/status.js"
    }
  ],
  "env": {
    "ALIYA_SERVERLESS_STATUS": "1",
    "NODE_NO_WARNINGS": "1"
  }
}
